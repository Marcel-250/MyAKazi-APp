{
  "name": "PurchaseOrder",
  "type": "object",
  "properties": {
    "po_number": {
      "type": "string"
    },
    "supplier_id": {
      "type": "string"
    },
    "supplier_name": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          }
        }
      }
    },
    "total_amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "RWF"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ordered",
        "received",
        "cancelled"
      ],
      "default": "draft"
    },
    "order_date": {
      "type": "string",
      "format": "date"
    },
    "branch_id": {
      "type": "string"
    }
  },
  "required": [
    "po_number",
    "total_amount",
    "status"
  ]
}